# Copiá a .env y completá la(s) key(s) del/los proveedor(es) que quieras evaluar.
# .env está gitignored — nunca se commitea.
#
# Uso:  set -a; . ./.env; set +a;  python -m benchmark_runner.cli run --model anthropic

# Tres adaptadores incluidos (gated por su key). Modelos por defecto entre [].
# Override con LLM_MODEL / OPENAI_MODEL / GEMINI_MODEL, o --model vendor:modelo.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8        # anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5             # openai (GPT-5.x usa max_completion_tokens)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash    # gemini
