# Copiá a .env y completá la(s) key(s) del/los proveedor(es) que quieras evaluar.
# .env está gitignored — nunca se commitea.
#
# Uso:  set -a; . ./.env; set +a;  python -m benchmark_runner.cli run --model anthropic

# Anthropic (Claude) — adaptador incluido.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8

# Otros proveedores requieren agregar su adaptador en benchmark_runner/adapters.py
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
